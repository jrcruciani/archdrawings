<mxfile host="diagrams.net">
  <diagram name="MongoDB to Cosmos DB Streaming with Fabric" id="ARCH-001">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1"
                  tooltips="1" connect="1" arrows="1" fold="1" page="1"
                  pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ===== BOUNDARIES ===== -->

        <!-- On-Premises boundary -->
        <mxCell id="2" value="On-Premises"
                style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=5 5;fillColor=none;strokeColor=#B0B0B0;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;fontSize=12;fontColor=#505050;fontStyle=1;arcSize=4;"
                vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="270" height="330" as="geometry"/>
        </mxCell>

        <!-- Microsoft Azure boundary -->
        <mxCell id="3" value="Microsoft Azure"
                style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#F5F5F5;strokeColor=#0078D4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontColor=#0078D4;fontStyle=1;arcSize=3;"
                vertex="1" parent="1">
          <mxGeometry x="370" y="90" width="930" height="540" as="geometry"/>
        </mxCell>

        <!-- Microsoft Fabric boundary (inside Azure) -->
        <mxCell id="4" value="Microsoft Fabric"
                style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=5 5;fillColor=none;strokeColor=#B0B0B0;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;fontSize=12;fontColor=#505050;fontStyle=1;arcSize=4;"
                vertex="1" parent="1">
          <mxGeometry x="870" y="140" width="390" height="320" as="geometry"/>
        </mxCell>

        <!-- Governance and Operations bar -->
        <mxCell id="5" value="Governance &amp; Operations"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#C0C0C0;strokeWidth=1;verticalAlign=top;align=center;spacingTop=5;fontSize=11;fontColor=#505050;fontStyle=1;arcSize=3;"
                vertex="1" parent="1">
          <mxGeometry x="400" y="505" width="560" height="95" as="geometry"/>
        </mxCell>

        <!-- ===== MAIN FLOW ICONS ===== -->

        <!-- MongoDB (on-prem source) -->
        <mxCell id="10" value="MongoDB&#xa;(Source DB)"
                style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#E8F5E9;strokeColor=#4CAF50;fontColor=#333333;fontSize=10;size=10;verticalLabelPosition=bottom;verticalAlign=top;align=center;"
                vertex="1" parent="1">
          <mxGeometry x="125" y="265" width="50" height="60" as="geometry"/>
        </mxCell>

        <!-- Self-Hosted Integration Runtime (on-prem agent) -->
        <mxCell id="11" value="Self-Hosted&#xa;Integration Runtime"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#B0B0B0;strokeWidth=1;fontSize=8;fontColor=#505050;fontStyle=0;align=center;verticalAlign=middle;"
                vertex="1" parent="1">
          <mxGeometry x="95" y="400" width="130" height="35" as="geometry"/>
        </mxCell>

        <!-- Azure Data Factory -->
        <mxCell id="12" value="Azure Data Factory&#xa;(CDC Pipeline)"
                style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;image=img/lib/azure2/databases/Data_Factory.svg;verticalLabelPosition=bottom;verticalAlign=top;"
                vertex="1" parent="1">
          <mxGeometry x="480" y="270" width="50" height="50" as="geometry"/>
        </mxCell>

        <!-- Azure Cosmos DB -->
        <mxCell id="13" value="Azure Cosmos DB&#xa;for MongoDB (vCore)"
                style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;image=img/lib/azure2/databases/Azure_Cosmos_DB.svg;verticalLabelPosition=bottom;verticalAlign=top;"
                vertex="1" parent="1">
          <mxGeometry x="700" y="270" width="50" height="50" as="geometry"/>
        </mxCell>

        <!-- Fabric Lakehouse -->
        <mxCell id="14" value="Fabric Lakehouse&#xa;(OneLake / Delta)"
                style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;image=img/lib/azure2/databases/Azure_Data_Explorer_Clusters.svg;verticalLabelPosition=bottom;verticalAlign=top;"
                vertex="1" parent="1">
          <mxGeometry x="940" y="260" width="50" height="50" as="geometry"/>
        </mxCell>

        <!-- Power BI -->
        <mxCell id="15" value="Power BI&#xa;(Dashboards &amp; Reports)"
                style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;image=img/lib/azure2/analytics/Power_BI_Embedded.svg;verticalLabelPosition=bottom;verticalAlign=top;"
