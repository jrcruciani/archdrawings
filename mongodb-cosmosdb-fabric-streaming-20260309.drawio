          <mxGeometry x="1150" y="260" width="50" height="50" as="geometry"/>
        </mxCell>

        <!-- ===== CROSS-CUTTING ICONS ===== -->

        <!-- Key Vault -->
        <mxCell id="16" value="Key Vault"
                style="image;aspect=fixed;html=1;points=[];align=center;fontSize=9;image=img/lib/azure2/security/Key_Vaults.svg;verticalLabelPosition=bottom;verticalAlign=top;"
                vertex="1" parent="1">
          <mxGeometry x="475" y="530" width="35" height="35" as="geometry"/>
        </mxCell>

        <!-- Azure Monitor -->
        <mxCell id="17" value="Azure Monitor"
                style="image;aspect=fixed;html=1;points=[];align=center;fontSize=9;image=img/lib/azure2/management_governance/Monitor.svg;verticalLabelPosition=bottom;verticalAlign=top;"
                vertex="1" parent="1">
          <mxGeometry x="625" y="530" width="35" height="35" as="geometry"/>
        </mxCell>

        <!-- Entra ID -->
        <mxCell id="18" value="Entra ID"
                style="image;aspect=fixed;html=1;points=[];align=center;fontSize=9;image=img/lib/azure2/identity/Azure_Active_Directory.svg;verticalLabelPosition=bottom;verticalAlign=top;"
                vertex="1" parent="1">
          <mxGeometry x="780" y="530" width="35" height="35" as="geometry"/>
        </mxCell>

        <!-- ===== CONNECTIONS (DATA FLOW) ===== -->

        <!-- MongoDB to ADF (main data flow via SHIR) -->
        <mxCell id="30" value="Change Streams"
                style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#404040;strokeWidth=1.5;fontColor=#505050;fontSize=9;"
                edge="1" source="10" target="12" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ADF to Cosmos DB -->
        <mxCell id="31" value="CDC Write"
                style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#404040;strokeWidth=1.5;fontColor=#505050;fontSize=9;"
                edge="1" source="12" target="13" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Cosmos DB to Fabric Lakehouse -->
        <mxCell id="32" value="Mirroring"
                style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#404040;strokeWidth=1.5;fontColor=#505050;fontSize=9;"
                edge="1" source="13" target="14" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Lakehouse to Power BI -->
        <mxCell id="33" value="DirectLake"
                style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#404040;strokeWidth=1.5;fontColor=#505050;fontSize=9;"
                edge="1" source="14" target="15" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- SHIR to ADF (dashed control plane) -->
        <mxCell id="34" value="Outbound HTTPS"
                style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#808080;strokeWidth=1;dashed=1;dashPattern=5 5;fontColor=#707070;fontSize=9;"
                edge="1" source="11" target="12" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== NUMBERED DATAFLOW ANNOTATIONS ===== -->

        <!-- Step 1 -->
        <mxCell id="40" value="1"
                style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;"
                vertex="1" parent="1">
          <mxGeometry x="300" y="268" width="24" height="24" as="geometry"/>
        </mxCell>

        <!-- Step 2 -->
        <mxCell id="41" value="2"
                style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;"
                vertex="1" parent="1">
          <mxGeometry x="590" y="268" width="24" height="24" as="geometry"/>
        </mxCell>

        <!-- Step 3 -->
        <mxCell id="42" value="3"
                style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;"
                vertex="1" parent="1">
          <mxGeometry x="820" y="262" width="24" height="24" as="geometry"/>
        </mxCell>

        <!-- Step 4 -->
        <mxCell id="43" value="4"
                style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;"
                vertex="1" parent="1">
          <mxGeometry x="1055" y="255" width="24" height="24" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
